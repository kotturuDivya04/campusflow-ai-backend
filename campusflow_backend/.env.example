# Copy to .env and adjust. Every value has a documented default in
# app/core/config.py; nothing is hard-coded in the business logic.

# --- database -------------------------------------------------------------
CAMPUSFLOW_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/campusflow

# --- auth -----------------------------------------------------------------
CAMPUSFLOW_JWT_SECRET=change-me-in-production
CAMPUSFLOW_JWT_ALGORITHM=HS256
CAMPUSFLOW_TOKEN_TTL_MIN=720

# --- scheduling defaults --------------------------------------------------
# These are FALLBACKS. If a matching row exists in the canonical
# system_settings table it wins (see app/services/buffer.py).
CAMPUSFLOW_BUFFER_MINUTES=5        # -> system_settings.APPOINTMENT_BUFFER_MINUTES
CAMPUSFLOW_MEETING_MINUTES=15      # -> system_settings.DEFAULT_MEETING_MINUTES
CAMPUSFLOW_BREAK_AFTER=0           # -> system_settings.QUEUE_BREAK_AFTER (0 = no breaks)
CAMPUSFLOW_BREAK_MINUTES=5         # -> system_settings.QUEUE_BREAK_MINUTES
CAMPUSFLOW_GRACE_MINUTES=10        # grace period before a no-show may be marked

# --- meta -----------------------------------------------------------------
CAMPUSFLOW_ENV=development
